# Sao chép thành backend/.env rồi điền giá trị. Không commit file .env.
HRIAM_ENV=development
# SQLite cho dev; production: postgresql+psycopg://user:pass@host:5432/hriam (cài thêm psycopg)
DATABASE_URL=sqlite:///hriam.db
# Tạo khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
PHONE_HMAC_KEY=
PHONE_HMAC_KEY_VERSION=v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Mô hình dịch: mặc định tự tìm runs/<hướng>-noi/best rồi runs/<hướng>/best
MT_ENABLED=true
# MODEL_EDE2VI=/duong/dan/mo-hinh
# MODEL_VI2EDE=/duong/dan/mo-hinh
