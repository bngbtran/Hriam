# Sao chép thành backend/.env rồi điền giá trị (chạy trên máy). Không commit file .env.
HRIAM_ENV=development

# Dev: SQLite. Supabase: chuỗi "Session pooler", đổi tiền tố thành postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:MATKHAU@aws-0-xx.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///hriam.db

# Tạo khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
PHONE_HMAC_KEY=
PHONE_HMAC_KEY_VERSION=v1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
TRUST_PROXY=false

# Mô hình dịch: mặc định dùng models/ede2vi và models/vi2ede
MT_ENABLED=true
MT_BEAMS=4
MT_PRELOAD=false
# Tuỳ chọn: tải mô hình từ repo Hugging Face riêng tư khi khởi động (cần biến HF_TOKEN)
# HF_MODEL_REPO=ten-ban/hriam-models

# Gemini (tuỳ chọn): văn bản người dùng được gửi ra ngoài (Google). Mô hình cục bộ luôn được ưu tiên khi MT_PROVIDER=auto.
# MT_PROVIDER: local (chỉ mô hình cục bộ) | auto (cục bộ trước, thiếu/lỗi thì Gemini, mặc định) | gemini (luôn Gemini)
# Key chỉ đặt trong backend/.env, không bao giờ ghi vào code.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-hydrogen
# Muốn nhanh hơn: GEMINI_THINKING_LEVEL=minimal (hoặc low); để trống = mặc định của model
# GEMINI_THINKING_LEVEL=
MT_PROVIDER=auto
